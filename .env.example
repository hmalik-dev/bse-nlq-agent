# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Model used to translate a question into SQL.
NLQ_SQL_MODEL=claude-sonnet-5

# Model used to turn query results into a written answer.
NLQ_ANSWER_MODEL=claude-sonnet-5

# Optional: pin "today" (YYYY-MM-DD) so relative dates like "last month" are
# reproducible. Defaults to the real current date.
NLQ_TODAY=
