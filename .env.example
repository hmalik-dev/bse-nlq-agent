# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Model used to translate a question into SQL. Chosen by the accuracy
# evaluation in docs/eval-results.md; run `uv run python -m eval.run` to redo it.
NLQ_SQL_MODEL=claude-sonnet-5

# Model used to turn query results into a written answer.
NLQ_ANSWER_MODEL=claude-sonnet-5

# Optional: the host names the server answers to, comma-separated. Defaults to
# localhost,127.0.0.1; any other Host header gets a 400 (docs/security.md).
# NLQ_ALLOWED_HOSTS=

# Docker only. The container seeds its database on first start; set
# NLQ_RESEED=1 to rebuild it on the next start. PORT changes the port inside
# the container (default 8000).
# NLQ_RESEED=
# PORT=
